{
  "name": "inboxpilot-demo-video",
  "version": "1.0.0",
  "private": true,
  "description": "Editable 60-second concept demo video for InboxPilot, built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:preview": "remotion render ProductDemo out/preview.mp4 --scale=0.5 --crf=30",
    "render": "remotion render ProductDemo out/inboxpilot-demo.mp4 --codec=h264",
    "still": "remotion still ProductDemo out/still.png --frame=1110"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
